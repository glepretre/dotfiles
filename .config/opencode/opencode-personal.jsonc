{
  "$schema": "https://opencode.ai/config.json",

  "provider": {
    "openrouter": {
      "options": {
        "apiKey": "{file:~/.config/opencode/openrouter-personal.key}"
      }
    }
  },

  "permission": {
    "read": {
      ".envrc": "ask"
    },
    "bash": {
      "gh *": "ask",
      "git push": "deny",
      "git push *": "deny",
      "rm *": "ask"
    }
  }
}
